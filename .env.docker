# ── JWT — MUST match the secret used to sign ANON_KEY / SERVICE_ROLE_KEY below
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# ── Supabase Keys (pre-signed with JWT_SECRET above) ─────
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7NfEnE9Wr3Ibin4uLx_jFuaJYFSQ7w6xKGg
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ── Site URLs ─────────────────────────────────────────────
SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000

# ── Ports ─────────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=54323
APP_PORT=3000

# ── SMTP → MailHog container (no auth needed) ─────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@forever.local
SMTP_SENDER_NAME=Forever
# true = sign-ups auto-confirm (password sign-in works immediately, no magic-link round-trip)
# false = users must click the link in MailHog (http://localhost:8025) before signing in
ENABLE_EMAIL_AUTOCONFIRM=true

# ── Optional — fill in for Map / AI features ─────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
ANTHROPIC_API_KEY=
