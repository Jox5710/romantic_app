############################################################
# Forever App — Docker environment
############################################################

# ── Database ─────────────────────────────────────────────
POSTGRES_PASSWORD=forever_local_2025

# ── JWT — MUST match the secret used to sign ANON_KEY / SERVICE_ROLE_KEY below
# (the demo keys are signed with the 56-char version WITHOUT trailing "-long")
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters

# ── Supabase Keys (freshly signed with JWT_SECRET above, exp 2036)
# Regenerate with supabase/keygen.ps1 if you change JWT_SECRET.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJlYWx0aW1lIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk4NDU0NTAsImV4cCI6MjA5NTIwNTQ1MH0.vQfnuMlaDDvRkozVTaFaQn7UNgNIcYH9moXxK-KpNAM
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJlYWx0aW1lIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc3OTg0NTQ1MCwiZXhwIjoyMDk1MjA1NDUwfQ.UIE5g0W_igCZ2lhs7JoyeK2SLG4EUHZTmdTyEcNRTvM

# ── Site URLs ─────────────────────────────────────────────
SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000

# ── Ports ─────────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=54323
APP_PORT=3000

# ── SMTP → MailHog container (no auth needed) ─────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@forever.local
SMTP_SENDER_NAME=Forever
# true = sign-ups auto-confirm (password sign-in works immediately, no magic-link round-trip)
# false = users must click the link in MailHog (http://localhost:8025) before signing in
ENABLE_EMAIL_AUTOCONFIRM=true

# ── Optional — fill in for Map / AI features ─────────────
NEXT_PUBLIC_MAPBOX_TOKEN=
ANTHROPIC_API_KEY=

# Wire the whisper "soften" (AI gentle rewording) feature to any LLM endpoint
# that accepts JSON {text, locale} and returns {softened: string}.
# Recommended: a serverless function (Vercel Edge, Cloud Run, Lambda) that
# calls Gemini / Anthropic / OpenAI and keeps the provider API key server-side.
# Leave empty to disable the feature gracefully — see DEPLOYMENT.md §14.
NEXT_PUBLIC_SOFTEN_URL=
