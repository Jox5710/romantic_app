############################################################
# Docker Compose — Forever App
# Copy to .env.docker and fill in values
############################################################

# ── Database ────────────────────────────────────────────
POSTGRES_PASSWORD=your-super-secret-postgres-password

# ── JWT Secrets ─────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# ── Supabase Keys (derived from JWT_SECRET) ─────────────
# Use: https://supabase.com/docs/guides/self-hosting/docker#generate-api-keys
# Or Supabase CLI: supabase status (for local dev)
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7NfEnE9Wr3Ibin4uLx_jFuaJYFSQ7w6xKGg
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0

# ── Site URLs ────────────────────────────────────────────
SITE_URL=http://localhost:3000
SUPABASE_PUBLIC_URL=http://localhost:8000

# ── Ports ────────────────────────────────────────────────
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=54323
APP_PORT=3000

# ── SMTP (optional — for magic link emails) ──────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_ADMIN_EMAIL=admin@yourapp.com
SMTP_SENDER_NAME=Forever

# Enable email autoconfirm (disable in production)
ENABLE_EMAIL_AUTOCONFIRM=true

# ── AI features (Gemini, server-side only) ──────────────
# Used by app/api/llm/* Route Handlers for Whisper soften, Missions, etc.
# Get a key at https://aistudio.google.com/apikey (free tier: 15 RPM, 1500 RPD).
# Leave empty to disable AI features gracefully.
GEMINI_API_KEY=AIzaSy...your-key-here
